# Copy to /opt/madis/.env on the VPS. Never commit the real file.
POSTGRES_DB=madis
POSTGRES_USER=madis
POSTGRES_PASSWORD=replace-with-a-long-hex-secret
DATABASE_URL=postgresql://madis:replace-with-a-long-hex-secret@postgres:5432/madis

JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-another-32-random-bytes
INITIAL_ADMIN_EMAIL=admin@madis.com
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Hostname only, without https:// or a trailing slash.
NGROK_DOMAIN=your-assigned-name.ngrok-free.app
NGROK_AUTHTOKEN=replace-with-your-ngrok-authtoken

ML_FORECAST_CACHE_TTL_MS=30000
MADIS_ADDRESS=AVARATRANTANIMORA
MADIS_NIF=4019 20 33 95
MADIS_STAT=46900 11 2025 0 03 535
MADIS_SLOGAN=SMART CHOICE, BETTER LIFE

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   Int                 @id @default(autoincrement()) @map("ID")
  email                String              @unique
  password             String
  userName             String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?
  roleId               Int
  role                 Role                @relation(fields: [roleId], references: [id])
  userPermissions      UserPermission[]
  createdSuppliers     Supplier[]          @relation("SupplierCreatedBy")
  updatedSuppliers     Supplier[]          @relation("SupplierUpdatedBy")
  deletedSuppliers     Supplier[]          @relation("SupplierDeletedBy")
  createdProducts      Product[]           @relation("ProductCreatedBy")
  updatedProducts      Product[]           @relation("ProductUpdatedBy")
  deletedProducts      Product[]           @relation("ProductDeletedBy")
  createdPricingGrids  PricingGrid[]       @relation("PricingGridCreatedBy")
  createdInventories   Inventory[]         @relation("InventoryCreatedBy")
  updatedInventories   Inventory[]         @relation("InventoryUpdatedBy")
  inventoryMovements   InventoryMovement[] @relation("InventoryMovementActor")
  soldCarts            Cart[]              @relation("CartSoldBy")
  validatedCarts       Cart[]              @relation("CartValidatedBy")
  createdSpecialOffers SpecialOffer[]      @relation("SpecialOfferCreatedBy")
  deletedSpecialOffers SpecialOffer[]      @relation("SpecialOfferDeletedBy")

  @@map("Users")
}

enum PricingGridStatus {
  ACTIVE
  ARCHIVED
  DRAFT
}

enum InventoryMovementType {
  INCOMING
  ADJUSTMENT
  SALE
  REFUND
  CANCELLATION
}

enum CartStatus {
  PENDING
  VALIDATED
  PAID
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  MVOLA
  AIRTEL_MONEY @map("AIRTEL MONEY")
  ORANGE_MONEY @map("ORANGE MONEY")
  CASH
}

enum SpecialOfferType {
  REDUCTION
  BUY_X_GET_N
}

enum SpecialOfferUnit {
  PERCENT
  FIXED
}

model Role {
  id              Int              @id @default(autoincrement()) @map("ID")
  label           String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  createdBy       Int?
  deletedBy       Int?
  users           User[]
  rolePermissions RolePermission[]

  @@map("Roles")
}

model Permission {
  id              Int              @id @default(autoincrement()) @map("ID")
  label           String
  code            String           @unique
  descriptions    String?
  createdBy       Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  deletedBy       Int?
  userPermissions UserPermission[]
  rolePermissions RolePermission[]

  @@map("Permissions")
}

model UserPermission {
  id           Int        @id @default(autoincrement()) @map("ID")
  userId       Int
  permissionId Int
  createdAt    DateTime   @default(now())
  createdBy    Int?
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  deletedBy    Int?
  user         User       @relation(fields: [userId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([userId, permissionId])
  @@map("UserPermissions")
}

model RolePermission {
  id           Int        @id @default(autoincrement()) @map("ID")
  roleId       Int
  permissionId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  createdBy    Int?
  deletedBy    Int?
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("RolePermissions")
}

model Supplier {
  id            Int         @id @default(autoincrement()) @map("ID")
  name          String
  address       String?
  phone         String?
  email         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  createdBy     Int
  updatedBy     Int?
  deletedBy     Int?
  createdByUser User        @relation("SupplierCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?       @relation("SupplierUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser User?       @relation("SupplierDeletedBy", fields: [deletedBy], references: [id])
  inventories   Inventory[]

  @@map("Suppliers")
}

model ProductMark {
  id        Int       @id @default(autoincrement()) @map("ID")
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("ProductMarks")
}

model ProductSpecification {
  id            Int       @id @default(autoincrement()) @map("ID")
  specification String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  products      Product[]

  @@map("ProductSpecifications")
}

model ProductFormat {
  id        Int       @id @default(autoincrement()) @map("ID")
  format    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("ProductFormats")
}

model ProductType {
  id        Int       @id @default(autoincrement()) @map("ID")
  type      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("ProductTypes")
}

model Product {
  id              Int                  @id @default(autoincrement()) @map("ID")
  name            String
  reference       String               @unique
  markId          Int
  specificationId Int
  formatId        Int
  productTypeId   Int
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?
  deletedBy       Int?
  createdBy       Int
  image           String?
  updatedBy       Int?
  mark            ProductMark          @relation(fields: [markId], references: [id])
  specification   ProductSpecification @relation(fields: [specificationId], references: [id])
  format          ProductFormat        @relation(fields: [formatId], references: [id])
  productType     ProductType          @relation(fields: [productTypeId], references: [id])
  createdByUser   User                 @relation("ProductCreatedBy", fields: [createdBy], references: [id])
  updatedByUser   User?                @relation("ProductUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser   User?                @relation("ProductDeletedBy", fields: [deletedBy], references: [id])
  inventories     Inventory[]

  @@map("Products")
}

model Inventory {
  id                     Int                     @id @default(autoincrement()) @map("ID")
  productId              Int
  quantity               Int
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  createdBy              Int
  purchasePrice          Decimal                 @db.Decimal(12, 2)
  salePrice              Decimal                 @db.Decimal(12, 2)
  updatedBy              Int?
  supplierId             Int
  wholesalePrice         Decimal                 @map("wholeSalePrice") @db.Decimal(12, 2)
  remainingQuantity      Int
  expiredAt              DateTime?
  product                Product                 @relation(fields: [productId], references: [id])
  supplier               Supplier                @relation(fields: [supplierId], references: [id])
  createdByUser          User                    @relation("InventoryCreatedBy", fields: [createdBy], references: [id])
  updatedByUser          User?                   @relation("InventoryUpdatedBy", fields: [updatedBy], references: [id])
  inventoryMovements     InventoryMovement[]
  cartDetails            CartDetail[]
  inventorySpecialOffers InventorySpecialOffer[]

  @@index([productId])
  @@index([supplierId])
  @@map("Inventories")
}

model InventoryMovement {
  id               Int                   @id @default(autoincrement()) @map("ID")
  inventoryId      Int
  incomingQuantity Int
  outgoingQuantity Int
  actorId          Int
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  purchasePrice    Decimal               @db.Decimal(12, 2)
  salePrice        Decimal               @db.Decimal(12, 2)
  type             InventoryMovementType
  wholesalePrice   Decimal               @map("wholeSalePrice") @db.Decimal(12, 2)
  cartId           Int?
  inventory        Inventory             @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  actor            User                  @relation("InventoryMovementActor", fields: [actorId], references: [id])
  cart             Cart?                 @relation(fields: [cartId], references: [id], onDelete: SetNull)

  @@index([inventoryId])
  @@index([actorId])
  @@index([cartId])
  @@map("InventoryMovement")
}

model Cart {
  id                 Int                 @id @default(autoincrement()) @map("ID")
  soldBy             Int
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  status             CartStatus          @default(VALIDATED)
  validatedBy        Int?
  totalPrice         Decimal             @db.Decimal(12, 2)
  customerName       String?
  customerContact    String?
  customerAddress    String?
  paymentMethod      PaymentMethod?
  reason             String?
  seller             User                @relation("CartSoldBy", fields: [soldBy], references: [id])
  validator          User?               @relation("CartValidatedBy", fields: [validatedBy], references: [id])
  cartDetails        CartDetail[]
  inventoryMovements InventoryMovement[]

  @@index([soldBy])
  @@index([validatedBy])
  @@map("Carts")
}

model CartDetail {
  id             Int           @id @default(autoincrement()) @map("ID")
  cartId         Int
  inventoryId    Int
  quantity       Int
  freeQuantity   Int?
  baseUnitPrice  Decimal       @db.Decimal(12, 2)
  finalUnitPrice Decimal       @db.Decimal(12, 2)
  discountAmount Decimal?      @db.Decimal(12, 2)
  wholesale      Boolean       @default(false) @map("wholeSale")
  specialOfferId Int?
  cart           Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  inventory      Inventory     @relation(fields: [inventoryId], references: [id])
  specialOffer   SpecialOffer? @relation(fields: [specialOfferId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@index([inventoryId])
  @@index([specialOfferId])
  @@map("CartDetails")
}

model SpecialOffer {
  id                     Int                     @id @default(autoincrement()) @map("ID")
  label                  String
  createdAt              DateTime                @default(now())
  createdBy              Int
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  deletedBy              Int?
  startDateTime          DateTime
  endDateTime            DateTime
  value                  Decimal?                @db.Decimal(12, 2)
  unit                   SpecialOfferUnit?
  buyQuantity            Int?
  freeQuantity           Int?
  type                   SpecialOfferType
  createdByUser          User                    @relation("SpecialOfferCreatedBy", fields: [createdBy], references: [id])
  deletedByUser          User?                   @relation("SpecialOfferDeletedBy", fields: [deletedBy], references: [id])
  inventorySpecialOffers InventorySpecialOffer[]
  cartDetails            CartDetail[]

  @@index([createdBy])
  @@index([deletedBy])
  @@index([startDateTime, endDateTime])
  @@map("SpecialOffers")
}

model InventorySpecialOffer {
  id             Int          @id @default(autoincrement()) @map("ID")
  inventoryId    Int
  specialOfferId Int
  limitDate      DateTime?
  inventory      Inventory    @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  specialOffer   SpecialOffer @relation(fields: [specialOfferId], references: [id], onDelete: Cascade)

  @@unique([inventoryId, specialOfferId])
  @@index([specialOfferId])
  @@index([limitDate])
  @@map("InventorySpecialOffers")
}

model PricingGrid {
  id            Int               @id @default(autoincrement()) @map("ID")
  status        PricingGridStatus
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime          @default(now())
  createdBy     Int
  updatedAt     DateTime          @updatedAt
  createdByUser User              @relation("PricingGridCreatedBy", fields: [createdBy], references: [id])
  pricingRules  PricingRule[]

  @@unique([effectiveFrom])
  @@map("PricingGrids")
}

model PricingRule {
  id                     Int         @id @default(autoincrement()) @map("ID")
  pricingGridId          Int
  minPurchasePrice       Int
  maxPurchasePrice       Int
  retailMarginPercent    Decimal     @db.Decimal(5, 2)
  wholesaleMarginPercent Decimal     @map("wholeSaleMarginPercent") @db.Decimal(5, 2)
  retailAverage          Decimal     @db.Decimal(12, 2)
  wholesaleAverage       Decimal     @map("wholeSaleAverage") @db.Decimal(12, 2)
  pricingGrid            PricingGrid @relation(fields: [pricingGridId], references: [id], onDelete: Cascade)

  @@unique([pricingGridId, minPurchasePrice, maxPurchasePrice])
  @@index([pricingGridId])
  @@map("PricingRules")
}
